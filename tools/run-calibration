#!/usr/bin/env bash
set -euo pipefail
repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cargo build --manifest-path "$repo_dir/Cargo.toml" --target-dir "$repo_dir/target" -p haptics-calibration
cd -- "$repo_dir"
case " ${*} " in
  *" --demo "*|*" --smoke-test "*|*" --sweep-smoke "*|*" --help "*|*" -h "*)
    exec "$repo_dir/target/debug/haptics-calibration" "$@" ;;
  *) exec "$repo_dir/tools/with-port-access" "$repo_dir/target/debug/haptics-calibration" "$@" ;;
esac
