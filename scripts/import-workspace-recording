#!/usr/bin/env python3
"""Convert input-only baseline CSV into a local Three.js evidence bundle."""
import csv, json, math, sys, hashlib, gzip, io
from pathlib import Path

def convert(path):
    raw=gzip.decompress(path.read_bytes()) if path.suffix == ".gz" else path.read_bytes()
    rows=list(csv.DictReader(io.StringIO(raw.decode())))
    if not rows or len(rows)>2_000_000: raise ValueError('Expected 1–2,000,000 input rows')
    cells={}; frames=[]; minimum=[math.inf]*3; maximum=[-math.inf]*3
    anchor=[int(rows[0][f'e{i}'])-int(rows[0][f'd{i}']) for i in range(6)]
    for i,r in enumerate(rows):
        p=[float(r[f'model_{a}_m']) for a in 'xyz']
        if not all(math.isfinite(v) and abs(v)<10 for v in p):raise ValueError('Invalid model point')
        cell=tuple(math.floor(v/.002) for v in p);cells.setdefault(cell,p)
        for a in range(3):minimum[a]=min(minimum[a],p[a]);maximum[a]=max(maximum[a],p[a])
        if i%10==0 or i==len(rows)-1: frames.append({'t':float(r['elapsed_ms'])/1000,'counts':[anchor[j]+int(r[f'd{j}']) for j in range(6)]})
    if len(cells)>40000 or len(frames)>40000:raise ValueError('Capture too large; split into smaller sessions')
    analysis_path=path.with_name('analysis.json');analysis=json.loads(analysis_path.read_text()) if analysis_path.exists() else {}
    return {'schema':1,'name':path.parent.name,'sample_count':len(rows),'duration_s':float(rows[-1]['elapsed_ms'])/1000,'source_sha256':hashlib.sha256(raw).hexdigest(),'points':list(cells.values()),'frames':frames,'span_mm':[(b-a)*1000 for a,b in zip(minimum,maximum)],'reference_model_m':analysis.get('reference_model_m'),'reference_label':analysis.get('owner_pose_label','No physical reference assigned'),'force_output':False,'workspace_verified':False}
if __name__=='__main__':
    if len(sys.argv)!=2:raise SystemExit('Usage: scripts/import-workspace-recording path/to/input.csv')
    output=Path(__file__).resolve().parents[1]/'apps/workspace-viewer/data/latest.json';output.parent.mkdir(parents=True,exist_ok=True)
    data=convert(Path(sys.argv[1]));output.write_text(json.dumps(data,separators=(',',':')))
    print(f'{len(data["points"])} spatial samples, {len(data["frames"])} replay frames -> {output}')
