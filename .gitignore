# Rust
/target
Cargo.lock.bak

# NEVER commit original vendor binaries, firmware, SDK installers, or disassembly output.
# See docs/clean-room/POLICY.md
/vendor-original/
/disasm/
*.sys
*.vxd
*.dll
*.exe
*.bin
*.iso
*.img

# Captures may be large; keep them in an external store and reference by hash.
/captures/**/*.sr
/captures/**/*.vcd
/captures/**/*.pcapng
/captures/calibration/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Python analysis-tool caches
/tools/**/__pycache__/
/apps/workspace-viewer/node_modules/
/captures/device-photos/
/apps/workspace-viewer/data/
/apps/workspace-viewer/photos
